# Optional overrides. Compose generates the ledger service key.
# N8N_HOST_PORT=5679
# AITS_HOST_PORT=8001
# Triage model. Read on the FIRST startup only; run "compose down -v" to change it.
# ollama (default, free, no key), anthropic, or openai.
# MODEL_PROVIDER=ollama
# OLLAMA_MODEL=granite4.2:3b
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Build a different AITS checkout.
# AITS_SOURCE=C:/Users/you/aits
