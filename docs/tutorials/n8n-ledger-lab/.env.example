# Optional overrides. Compose generates the ledger service key.
# N8N_HOST_PORT=5679
# AITS_HOST_PORT=8001
# Optional: configure the triage model credential on the FIRST startup.
# Otherwise, add your OpenAI credential in the n8n editor after account setup.
# OPENAI_API_KEY=
# Build a different AITS checkout.
# AITS_SOURCE=C:/Users/you/aits
