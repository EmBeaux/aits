      "name": "Check proposal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [820, 0],
      "parameters": {
        "jsCode": "const issue = $('Prepare issue').first().json;\nlet proposal;\ntry {\n  proposal = JSON.parse($input.first().json.output);\n} catch {\n  return [{ json: { issueKey: issue.issueKey, decision: 'review', reason: 'invalid_json' } }];\n}\nconst hasReproduction = /\\bReproduction:\\s*\\S/i.test(issue.body);\nconst allowed = proposal?.label === 'bug' && hasReproduction;\nreturn [{ json: {\n  issueKey: issue.issueKey,\n  decision: allowed ? 'allow' : 'review',\n  reason: allowed ? 'reproduction_present' : 'needs_maintainer_review',\n} }];"
      }
    },
